   ]
  },
  "bio": [
   {
    "text": "Furious at the burning of children at Elgaud, Thalia confronted Odric and declared she could no longer serve Avacyn and her church.",
    "cites": [
     "lunarch-inquisition-2016-05-04-e1",
     "lunarch-inquisition-2016-05-04-e4"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/lunarch-inquisition-2016-05-04#:~:text=We%27re%20burning%20children%20now.",
     "https://magic.wizards.com/en/news/magic-story/lunarch-inquisition-2016-05-04#:~:text=I%20can%20no%20longer,Avacyn%20and%20her%20church."
    ]
   },
   {
    "text": "She accused Bishop Jerren of leading the Skirsdag, but the council removed her title and called for her execution, and Odric helped her escape Thraben.",
    "cites": [
     "lunarch-inquisition-2016-05-04-e8",
     "lunarch-inquisition-2016-05-04-e7",
     "lunarch-inquisition-2016-05-04-e12",
     "lunarch-inquisition-2016-05-04-e17"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/lunarch-inquisition-2016-05-04#:~:text=I%20bring%20evidence%20that,leader%20of%20the%20Skirsdag.",
     "https://magic.wizards.com/en/news/magic-story/lunarch-inquisition-2016-05-04#:~:text=The%20council%20has%20removed%20it%20from%20you.",
     "https://magic.wizards.com/en/news/magic-story/lunarch-inquisition-2016-05-04#:~:text=Cathars%20came%20and%20seized,to%20Jerren%20for%20direction.",
     "https://magic.wizards.com/en/news/magic-story/lunarch-inquisition-2016-05-04#:~:text=And%20they%20left%20the,old%20lives%20far%20behind."
    ]
   },
   {
    "text": "She founded the Order of Saint Traft, welcoming Grete, and the geist of Saint Traft appeared beside her.",
    "cites": [
     "lunarch-inquisition-2016-05-04-e18",
     "lunarch-inquisition-2016-05-04-e19",
     "lunarch-inquisition-2016-05-04-r11"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/lunarch-inquisition-2016-05-04#:~:text=Welcome%20to%20the%20Order%20of%20Saint%20Traft%2C",
     "https://magic.wizards.com/en/news/magic-story/lunarch-inquisition-2016-05-04#:~:text=radiant%20but%20insubstantial%2C%20a%20holy%20geist.",
     "https://magic.wizards.com/en/news/magic-story/lunarch-inquisition-2016-05-04#:~:text=Welcome%20to%20the%20Order%20of%20Saint%20Traft%2C"
    ]
   },
   {
    "text": "Leading the order, she lifted Avacyn's broken spear with Saint Traft's power, agreed a truce with Olivia Voldaren, and drove the spear through the fused angel Bruna-Gisela.",
    "cites": [
     "saint-traft-and-flight-nightmares-2016-07-13-e3",
     "saint-traft-and-flight-nightmares-2016-07-13-e8",
     "saint-traft-and-flight-nightmares-2016-07-13-e19",
     "saint-traft-and-flight-nightmares-2016-07-13-r8"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/saint-traft-and-flight-nightmares-2016-07-13#:~:text=We%20ride%20under%20this%20banner%20now%2C",
     "https://magic.wizards.com/en/news/magic-story/saint-traft-and-flight-nightmares-2016-07-13#:~:text=No%20vampire%20bite%20or,Heir%20of%20Saint%20Traft.",
     "https://magic.wizards.com/en/news/magic-story/saint-traft-and-flight-nightmares-2016-07-13#:~:text=she%20drove%20Avacyn%27s%20spear,deep%20into%20the%20spine",
     "https://magic.wizards.com/en/news/magic-story/saint-traft-and-flight-nightmares-2016-07-13#:~:text=she%20drove%20Avacyn%27s%20spear,deep%20into%20the%20spine"
    ]
   },
   {
    "text": "She later crashed through a chapel roof to fight alongside Odric against Henrika Domnathi's vampires and stabbed Henrika, who fled as mist.",
    "cites": [
     "blessing-blood-2021-11-05-e9",
     "blessing-blood-2021-11-05-e12",
     "blessing-blood-2021-11-05-e15"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/blessing-blood-2021-11-05#:~:text=Thalia%20came%20down%20along,her%20and%20landed%20hard",
     "https://magic.wizards.com/en/news/magic-story/blessing-blood-2021-11-05#:~:text=Henrika%20slit%20the%20throat%20of%20the%20father.",
     "https://magic.wizards.com/en/news/magic-story/blessing-blood-2021-11-05#:~:text=%22There%20is%20blessed%20water%20in%20your%20blood%E2%80%94%3F%21%22"
    ]
   },
   {
    "text": "In the Echoverse, Avacyn ordered Odric to kill Thalia after she abandoned the Helvault.",
    "cites": [
     "the-legends-of-reality-fracture-e23",
     "the-legends-of-reality-fracture-r36"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/the-legends-of-reality-fracture#:~:text=Avacyn%20ordered%20Odric%2C%20Thalia%27s,comrade%2C%20to%20kill%20Thalia.",
     "https://magic.wizards.com/en/news/magic-story/the-legends-of-reality-fracture#:~:text=She%20abandoned%20her%20post%20to%20confront%20the%20archangel."
    ]
   }
  ],
  "status": {
   "text": "In the main story Thalia was last seen standing with the vampiric Odric after the chapel fight, while her Echoverse spirit was killed on Avacyn's order.",
