  "bio": [
   {
    "text": "It is introduced as the newly built official sanctum of the Living Guildpact, where Jace arrives late to find Boros minotaurs complaining that the Orzhov have violated a boundary contract.",
    "cites": [
     "p:stories/gorgon-and-guildpact-2014-03-12",
     "gorgon-and-guildpact-2014-03-12-e0"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/gorgon-and-guildpact-2014-03-12",
     "https://magic.wizards.com/en/news/magic-story/gorgon-and-guildpact-2014-03-12#:~:text=The%20Orzhov%20violated%20our%20boundary%20contract%21"
    ]
   },
   {
    "text": "Jace rules that the minotaurs must file a proper complaint with Lavinia, and later Lavinia reports back at the Chamber that the guilds now know of Vraska while Jace prepares to leave for a few days.",
    "cites": [
     "gorgon-and-guildpact-2014-03-12-e1",
     "gorgon-and-guildpact-2014-03-12-e13"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/gorgon-and-guildpact-2014-03-12#:~:text=You%20will%20file%20a,complaint%20with%20Deputy%20Lavinia",
     "https://magic.wizards.com/en/news/magic-story/gorgon-and-guildpact-2014-03-12#:~:text=And%20I%20think%20something%27s%20up%20with%20Garruk."
    ]
   },
   {
    "text": "Gideon arrives in Ravnica intending to ask Jace for help and collapses on the steps of the Chamber, and Jace holds appointments there as the Living Guildpact.",
    "cites": [
     "limits-2015-07-15-e13",
     "p:stories/catching-2015-07-22"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/limits-2015-07-15#:~:text=Gideon%20ascended%20the%20first,him%2C%20and%20he%20collapsed.",
     "https://magic.wizards.com/en/news/magic-story/catching-2015-07-22"
    ]
   },
   {
    "text": "In March of the Machine, Vraska's forces destroy the roof of the Chamber of the Guildpact and Niv-Mizzet's seat.",
    "cites": [
     "one-and-the-same-e11"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/one-and-the-same#:~:text=delighting%20in%20crushing%20Niv%2DMizzet%27s%20seat"
    ]
   },
   {
    "text": "In Reality Fracture, its imaginary ruins hold Jace's former sanctum within a memory-prison, and the Theorist visits the Guildpact there to have him check his proofs, which show the overlay is collapsing.",
    "cites": [
     "p:stories/planeswalkers-guide-to-reality-fracture",
     "reality-fracture-episode-3-i-can-be-both-e8"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/planeswalkers-guide-to-reality-fracture",
     "https://magic.wizards.com/en/news/magic-story/reality-fracture-episode-3-i-can-be-both#:~:text=%22It%27s%20collapsing%2C%22%20concludes%20the%20Guildpact."
    ]
   },
   {
    "text": "The Guildpact warns that the Theorist intends to overwrite their home, and the Theorist puts him to sleep.",
    "cites": [
     "reality-fracture-episode-3-i-can-be-both-e10"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/reality-fracture-episode-3-i-can-be-both#:~:text=The%20Theorist%20flicks%20a,sick%20thud%2C%20dead%20asleep."
    ]
   }
  ],
