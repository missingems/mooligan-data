    ]
   },
   {
    "text": "She blasts through its gates and fights her way up the stairs through slumbering knights who attack her.",
    "cites": [
     "episode-3-two-great-banquets-e1"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/episode-3-two-great-banquets#:~:text=Aiming%20at%20his%20feet,she%20channels%20another%20blast."
    ]
   },
   {
    "text": "Kellan and Ruby later ride there and jump over its gates with the second frog potion, find Rowan in the throne room, and are knocked out by her.",
    "cites": [
     "episode-5-broken-oaths-e0",
     "episode-5-broken-oaths-e1",
     "episode-5-broken-oaths-e2"
    ],
    "links": [
