":[],"date":"","url":"https://mtg.wiki/page/Tarkir","link":"https://mtg.wiki/page/Tarkir","archived":null,"license":"CC BY-NC-SA 4.0, MTG Wiki contributors","text":"\"Tarkir\". MTG Wiki contributors, CC BY-NC-SA 4.0, MTG Wiki contributors."}]},"bio":[{"text":"When Ugin arrived on Tarkir and formed the plane, his wing beats birthed the dragonstorms, and when he was gravely injured by Nicol Bolas his essence empowered them.","cites":["dragonstorm-phenomenon-e0","dragonstorm-phenomenon-e1","dragonstorm-phenomenon-r6"],"links":["https://mtg.wiki/page/Dragonstorm_%28phenomenon%29#:~:text=his%20wing%20beats%20birthed%20the%20dragonstorms.","https://mtg.wiki/page/Dragonstorm_%28phenomenon%29#:~:text=he%20entered%20a%20long,a%20nest%20of%20hedrons","https://mtg.wiki/page/Dragonstorm_%28phenomenon%29#:~:text=his%20wing%20beats%20birthed%20the%20dragonstorms."],"citations":[{"source":"mtg-wiki","official":false,"publisher":"MTG Wiki contributors","work":"Dragonstorm (phenomenon)","series":"MTG Wiki","authors":[],"date":"","url":"https://mtg.wiki/page/Dragonstorm_%28phenomenon%29","link":"https://mtg.wiki/page/Dragonstorm_%28phenomenon%29#:~:text=his%20wing%20beats%20birthed%20the%20dragonstorms.","archived":null,"license":"CC BY-NC-SA 4.0, MTG Wiki contributors","text":"\"Dragonstorm (phenomenon)\", section \"Current timeline\". MTG Wiki contributors, CC BY-NC-SA 4.0, MTG Wiki contributors."},{"source":"mtg-wiki","official":false,"publisher":"MTG Wiki contributors","work":"Dragonstorm (phenomenon)","series":"MTG Wiki","authors":[],"date":"","url":"https://mtg.wiki/page/Dragonstorm_%28phenomenon%29","link":"https://mtg.wiki/page/Dragonstorm_%28phenomenon%29#:~:text=he%20entered%20a%20long,a%20nest%20of%20hedrons","archived":null,"license":"CC BY-NC-SA 4.0, MTG Wiki contributors","text":"\"Dragonstorm (phenomenon)\", section \"Current timeline\". MTG Wiki contributors, CC BY-NC-SA 4.0, MTG Wiki contributors."},{"source":"mtg-wiki","official":false,"publisher":"MTG Wiki contribu