  "bio": [
   {
    "text": "Hapatra, a vizier of Rhonas's monument, learned from him and was devoted to him.",
    "cites": [
     "writing-wall-2017-04-12-r2",
     "hour-promise-2017-06-28-r3"
    ],
    "links": [
