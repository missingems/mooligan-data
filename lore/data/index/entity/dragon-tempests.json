hive/uncharted-realms/planeswalkers-guide-dragons-tarkir-part-1-2015-03-11#:~:text=he%20traveled%20back%20in,Spirit%20Dragon%2C%20from%20death"],"citations":[{"source":"wizards","official":true,"publisher":"Wizards of the Coast","work":"Tarkir","series":"Magic: The Gathering story profiles","authors":[],"date":"","url":"https://magic.wizards.com/en/story/tarkir-plane","link":"https://magic.wizards.com/en/story/tarkir-plane#:~:text=he%20travelled%20back%20in,Spirit%20Dragon%2C%20from%20death.","archived":null,"license":null,"text":"\"Tarkir\". Magic: The Gathering story profiles, Wizards of the Coast."},{"source":"wizards-archive","official":true,"publisher":"Wizards of the Coast","work":"Planeswalker's Guide to Dragons of Tarkir, Part 1","series":"Uncharted Realms","authors":[],"date":"2015-03-11","url":"http://magic.wizards.com/en/articles/archive/uncharted-realms/planeswalkers-guide-dragons-tarkir-part-1-2015-03-11","link":"https://web.archive.org/web/20150311151143/http://magic.wizards.com/en/articles/archive/uncharted-realms/planeswalkers-guide-dragons-tarkir-part-1-2015-03-11#:~:text=he%20traveled%20back%20in,Spirit%20Dragon%2C%20from%20death","archived":"https://web.archive.org/web/20150311151143/http://magic.wizards.com/en/articles/archive/uncharted-realms/planeswalkers-guide-dragons-tarkir-part-1-2015-03-11","license":null,"text":"\"Planeswalker's Guide to Dragons of Tarkir, Part 1\". Uncharted Realms, Wizards of the Coast, 11 Mar 2015. Archived by the Internet Archive."}]},{"text":"With dragons secured, their numbers grew and they hunted down and destroyed the khans.","cites":["uncharted-realms-planeswalkers-guide-dragons-tarkir-part-1-2015-03-11-e1"],"links":["https://web.archive.org/web/20150311151143/http://magic.wizards.com/en/articles/archive/uncharted-realms/planeswalkers-guide-dragons-tarkir-part-1-2015-03-11#:~:text=Ultimately%2C%20the%20dragons%20were,khans%20and%20destroy%20them."],"citations":[{"source":"wizards-archive","official":true,"publisher":"Wizards of the Coast","work":"Planeswalker's Guide to Dragons of Tarkir, Part 1","series":"Uncharted Realms","authors":[],"date":"2015-03-11","url":"http://magic.wizards.com/en/articles/archive/uncharted-realms/planeswalkers-guide-dragons-tarkir-part-1-2015-03-11","link":"https://web.archive.org/web/20150311151143/http://magic.wizards.com/en/articles/archive/uncharted-realms/planeswalkers-guide-dragons-tarkir-part-1-2015-03-11#:~:text=Ultimately%2C%20the%20dragons%20were,khans%20and%20destroy%20them.","archived":"https://web.archive.org/web/20150311151143/http://magic.wizards.com/en/articles/archive/uncharted-realms/planeswalkers-guide-dragons-tarkir-part-1-2015-03-11","license":null,"text":"\"Planeswalker's Guide to Dragons of Tarkir, Part 1\". Uncharted Realms, Wizards of the Coast, 11 Mar 2015. Archived by the Internet Archive."}]}],"status":{"text":"In the new Tarkir the tempests are still active and producing new dragons, because Ugin's magic persists.","cites":["tarkir-dragons-2015-02-25-e2","uncharted-realms-reforged-chain-2015-01-21-e19"],"links":["https://magic.wizards.com/en/news/magic-story/tarkir-dragons-2015-02-25#:~:text=As%20he%20shot%20back,tempest%20rupturing%20before%20him.","https://web.archive.org/web/20150124070850/http://magic.wizards.com:80/en/articles/archive/uncharted-realms/reforged-chain-2015-01-21#:~:text=New%20dragons%20erupted%20from,unrestrained%20glory%20of%20being."],"citations":[{"source":"wizards","official":true,"publisher":"Wizards of the Coast","work":"A Tarkir of Dragons","series":"Magic Story","authors":["Kimberly J. Kreines"],"date":"2015-02-25","url":"https://magic.wizards.com/en/news/magic-story/tarkir-dragons-2015-02-25","link":"https://magic.wizards.com/en/news/magic-story/tarkir-dragons-2015-02-25#:~:text=As%20he%20shot%20back,tempest%20rupturing%20before%20him.","archived":null,"license":null,"text":"\"A Tarkir of Dragons\" by Kimberly J. Kreines. Magic Story, Wizards of the Coast, 25 Feb 2015."},{"source":"wizards-