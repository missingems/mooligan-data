arted-realms/last-day-2013-06-03","link":"https://web.archive.org/web/20160312043336/http://magic.wizards.com:80/en/articles/archive/uncharted-realms/last-day-2013-06-03#:~:text=%22Have%20it%20your%20way%2C%20agent.%22","archived":"https://web.archive.org/web/20160312043336/http://magic.wizards.com:80/en/articles/archive/uncharted-realms/last-day-2013-06-03","license":null,"text":"\"Last Day\". Uncharted Realms, Wizards of the Coast, 3 Jun 2013. Archived by the Internet Archive."}},{"id":"uncharted-realms-last-day-2013-06-03-e7","era":null,"summary":"Liric reunites with his father, the Dimir interpreter, at the wall of sand.","participants":["liric","liric-s-father","wall-of-sand"],"location":"ismeri","importance":"minor","page":"archive/uncharted-realms-last-day-2013-06-03","order":397,"story_date":"2013-06-03","storyline":"Ravnica: City of Guilds","source":"wizards-archive","paragraph":34,"quote":"\"Hi Dad,\" Liric said.","link":"https://web.archive.org/web/20160312043336/http://magic.wizards.com:80/en/articles/archive/uncharted-realms/last-day-2013-06-03#:~:text=%22Hi%20Dad%2C%22%20Liric%20said.","citation":{"source":"wizards-archive","official":true,"publisher":"Wizards of the Coast","work":"Last Day","series":"Uncharted Realms","authors":[],"date":"2013-06-03","url":"http://magic.wizards.com:80/en/articles/archive/uncharted-realms/last-day-2013-06-03","link":"https://web.archive.org/web/20160312043336/http://magic.wizards.com:80/en/articles/archive/uncharted-realms/last-day-2013-06-03#:~:text=%22Hi%20Dad%2C%22%20Liric%20said.","archived":"https://web.archive.org/web/20160312043336/http://magic.wizards.com:80/en/articles/archive/uncharted-realms/last-day-2013-06-03","license":null,"text":"\"Last Day\". Uncharted Realms, Wizards of the Coast, 3 Jun 2013. Archived by the Internet Archive."}},{"id":"uncharted-realms-last-day-2013-06-03-e8","era":null,"summary":"Flashback: Liric was elevated to Dimir remainder in a ceremony where a guildmage sealed his strand with a coin bearing Lazav's likeness.","participants":["liric","liric-s-father","lazav"],"location":"ravnica","importance":"minor","page":"archive/uncharted-realms-last-day-2013-06-03","order":397,"story_date":"2013-06-03","storyline":"Ravnica: City of Guilds","source":"wizards-archive","paragraph":35,"quote":"A symbol of the voided circle.","link":"https://web.archive.org/web/20160312043336/http://magic.wizards.com:80/en/articles/archive/uncharted-realms/last-day-2013-06-03#:~:text=A%20symbol%20of%20the%20voided%20circle.","citation":{"source":"wizards-archive","official":true,"publisher":"Wizards of the Coast","work":"Last Day","series":"Uncharted Realms","authors":[],"date":"2013-06-03","url":"http://magic.wizards.com:80/en/articles/archive/uncharted-realms/last-day-2013-06-03","link":"https://web.archive.org/web/20160312043336/http://magic.wizards.com:80/en/articles/archive/uncharted-realms/last-day-2013-06-03#:~:text=A%20symbol%20of%20the%20voided%20circle.","archived":"https://web.archive.org/web/20160312043336/http://magic.wizards.com:80/en/articles/archive/uncharted-realms/last-day-2013-06-03","license":null,"text":"\"Last Day\". Uncharted Realms, Wizards of the Coast, 3 Jun 2013. Archived by the Internet Archive."}},{"id":"uncharted-realms-last-day-2013-06-03-e9","era":null,"summary":"Seven days earlier Liric had blanked the guildmage who performed his remainder, the only other person who could remember him.","participants":["liric"],"location":"ravnica","importance":"minor","page":"archive/uncharted-realms-last-day-2013-06-03","order":397,"story_date":"2013-06-03","storyline":"Ravnica: City of Guilds","source":"wizards-archive","paragraph":36,"quote":"Liric had left the man blanked, slumped against a column in the Dinrova.","link":"https://web.archive.org/web/20160312043336/http://magic.wizards.com:80/en/articles/archive/uncharted-realms/last-day-2013-06-03#:~:text=Liric%20had%20left%20the,column%20in%20the%20Dinrova.","citation":{"source":"wizards-archive","off