  "bio": [
   {
    "text": "On the eve of their Harvest, Samut finds Nakht by the river, and the friends play-fight and share their fears of being separated.",
    "cites": [
     "trespass-2017-05-10-e0",
     "trespass-2017-05-10-e1"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/trespass-2017-05-10#:~:text=Samut%20gave%20him%20a,back%20into%20the%20water",
     "https://magic.wizards.com/en/news/magic-story/trespass-2017-05-10#:~:text=What%20if%20my%20faith%20falters%3F"
    ]
   },
   {
    "text": "A winged demon flies through the Gate and spills its own blood into the Luxa, turning the river to blood and killing the creatures in it.",
    "cites": [
     "hour-revelation-2017-06-07-e16",
     "hour-revelation-2017-06-07-e17"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/hour-revelation-2017-06-07#:~:text=Demons%20were%20rare%20on%20Amonkhet.",
     "https://magic.wizards.com/en/news/magic-story/hour-revelation-2017-06-07#:~:text=The%20demon%20had%20turned%20the%20river%20into%20blood."
    ]
   },
   {
    "text": "The demon calls out for Liliana Vess, and she waits at the bloody river as Razaketh summons her.",
    "cites": [
     "hour-revelation-2017-06-07-e19",
     "feast-2017-06-14-e0"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/hour-revelation-2017-06-07#:~:text=I%20know%20you%20are,cannot%20hide%20from%20me.",
     "https://magic.wizards.com/en/news/magic-story/feast-2017-06-14#:~:text=Jace%3F%20Can%20you%20hear%20me%3F"
    ]
   },
   {
    "text": "Razaketh commands Liliana to come to him, and her body wades into the river of blood against her will until she is forced beneath the surface.",
    "cites": [
     "feast-2017-06-14-e3",
     "feast-2017-06-14-e4"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/feast-2017-06-14#:~:text=her%20body%20waded%20forward,the%20river%20of%20blood.",
     "https://magic.wizards.com/en/news/magic-story/feast-2017-06-14#:~:text=You%20are%20only%20free,of%20your%20demons%2C%20Liliana."
    ]
   },
   {
    "text": "She raises the river's dead animals against him, possesses two dozen dead crocodiles and devours Razaketh, killing him.",
    "cites": [
     "feast-2017-06-14-e14",
     "feast-2017-06-14-e15"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/feast-2017-06-14#:~:text=a%20menagerie%20of%20death,the%20river%20of%20blood.",
     "https://magic.wizards.com/en/news/magic-story/feast-2017-06-14#:~:text=her%20two%20dozen%20selves,of%20the%20demon%20Razaketh."
    ]
   },
   {
    "text": "All five gods then gather at the bloody Luxa, but the God-Pharaoh does not arrive, and the river drains through the opened Gate as the demon's spell unravels old magics.",
    "cites": [
     "hour-glory-2017-06-21-e2",
     "hour-glory-2017-06-21-e3"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/hour-glory-2017-06-21#:~:text=The%20five%20stood%20before,shores%20of%20the%20Luxa",
     "https://magic.wizards.com/en/news/magic-story/hour-glory-2017-06-21#:~:text=all%20that%20remained%20of,few%20rivulets%20of%20red"
    ]
   },
   {
    "text": "Its blood-stained water later recedes and leaves an empty riverbed, and a final mention has it running blood red with fish corpses.",
    "cites": [
     "p:stories/hour-promise-2017-06-28",
     "p:stories/hour-eternity-2017-07-12"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/hour-promise-2017-06-28",
     "https://magic.wizards.com/en/news/magic-story/hour-eternity-2017-07-12"
    ]
   }
  ],
