   "order": 198,
   "story_date": "2018-06-13",
   "storyline": "Chronicle of Bolas",
   "source": "wizards",
   "paragraph": 87,
   "quote": "These two were too weak to wake up. Good riddance.",
   "link": "https://magic.wizards.com/en/news/magic-story/chronicle-bolas-twins-2018-06-13#:~:text=These%20two%20were%20too,wake%20up.%20Good%20riddance."
  },
  {
   "id": "chronicle-bolas-twins-2018-06-13-e11",
   "summary": "Merrevia Sal crashes into a clearing and demands meat from a party of hunters.",
   "participants": [
    "merrevia-sal",
    "chevill-s-hunters"
   ],
   "location": "qal-sisma",
   "importance": "minor",
   "page": "stories/chronicle-bolas-twins-2018-06-13",
   "order": 198,
   "story_date": "2018-06-13",
   "storyline": "Chronicle of Bolas",
   "source": "wizards",
   "paragraph": 96,
   "quote": "I am Merrevia Sal. Give me the meat, or I will kill you.",
   "link": "https://magic.wizards.com/en/news/magic-story/chronicle-bolas-twins-2018-06-13#:~:text=I%20am%20Merrevia%20Sal.,I%20will%20kill%20you."
  },
  {
   "id": "chronicle-bolas-twins-2018-06-13-e12",
   "summary": "The last egg-stone unfurls into twin dragons, Nicol and Ugin, who crash through the canopy; Nicol is pinned by a tree trunk.",
   "participants": [
    "nicol-bolas",
    "ugin"
   ],
   "location": "qal-sisma",
   "importance": "major",
   "page": "stories/chronicle-bolas-twins-2018-06-13",
   "order": 198,
   "story_date": "2018-06-13",
   "storyline": "Chronicle of Bolas",
   "source": "wizards",
   "paragraph": 100,
   "quote": "You're Nicol, aren't you? That's your name.",
   "link": "https://magic.wizards.com/en/news/magic-story/chronicle-bolas-twins-2018-06-13#:~:text=You%27re%20Nicol%2C%20aren%27t%20you%3F%20That%27s%20your%20name."
  },
  {
   "id": "chronicle-bolas-twins-2018-06-13-e13",
   "summary": "Hunters work together to net and kill Merrevia Sal while Nicol, pinned, wants to help but Ugin holds him back.",
   "participants": [
