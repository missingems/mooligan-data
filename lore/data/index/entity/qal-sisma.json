  },
  {
   "id": "chronicle-bolas-twins-2018-06-13-e17",
   "summary": "From the peak Nicol sees the bodies of weak dragons and decides being the hunter is better, while Ugin stares at the sky and asks where they came from.",
   "participants": [
    "nicol-bolas",
    "ugin"
   ],
   "location": "qal-sisma",
   "importance": "major",
   "page": "stories/chronicle-bolas-twins-2018-06-13",
   "order": 198,
   "story_date": "2018-06-13",
   "storyline": "Chronicle of Bolas",
   "source": "wizards",
   "paragraph": 153,
   "quote": "Dying isn't wonderful. It's bad. But being the hunter: that's a better thing.",
   "link": "https://magic.wizards.com/en/news/magic-story/chronicle-bolas-twins-2018-06-13#:~:text=Dying%20isn%27t%20wonderful.%20It%27s,that%27s%20a%20better%20thing."
  },
  {
   "id": "chronicle-bolas-twins-2018-06-13-e18",
   "summary": "In the vision Ugin calls Yasova Dragonclaw to come to him.",
   "participants": [
    "ugin",
    "yasova-dragonclaw"
   ],
   "location": "qal-sisma",
   "importance": "major",
   "page": "stories/chronicle-bolas-twins-2018-06-13",
   "order": 198,
   "story_date": "2018-06-13",
   "storyline": "Chronicle of Bolas",
   "source": "wizards",
   "paragraph": 158,
   "quote": "Someone is looking for you, Yasova Dragonclaw. Come to me.",
   "link": "https://magic.wizards.com/en/news/magic-story/chronicle-bolas-twins-2018-06-13#:~:text=Someone%20is%20looking%20for,Dragonclaw.%20Come%20to%20me."
  },
  {
   "id": "chronicle-bolas-twins-2018-06-13-e19",
   "summary": "Three of Atarka's broodlings land at the camp demanding the clan surrender its shamans.",
