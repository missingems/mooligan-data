    "merrevia-sal",
    "nicol-bolas",
    "ugin"
   ],
   "location": "qal-sisma",
   "importance": "major",
   "page": "stories/chronicle-bolas-twins-2018-06-13",
   "order": 198,
   "story_date": "2018-06-13",
   "storyline": "Chronicle of Bolas",
   "source": "wizards",
   "paragraph": 110,
   "quote": "Yet still she struggles, still she fights because she is a dragon, and dragons never bow before lesser creatures.",
   "link": "https://magic.wizards.com/en/news/magic-story/chronicle-bolas-twins-2018-06-13#:~:text=Yet%20still%20she%20struggles%2C,bow%20before%20lesser%20creatures."
  },
  {
   "id": "chronicle-bolas-twins-2018-06-13-e14",
   "summary": "Ugin clamps Nicol's muzzle to hush him as Merrevia is hunted into the trees and dies.",
