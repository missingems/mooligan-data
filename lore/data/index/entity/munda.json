  "bio": [
   {
    "text": "Munda and his band found Gideon and told him that Bala Ged had been overrun and destroyed, and later that a great Eldrazi host descended on Sea Gate.",
    "cites": [
     "limits-2015-07-15-e1",
     "limits-2015-07-15-e7"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/limits-2015-07-15#:~:text=Bala%20Ged%2C%20the%20entire,be%20overrun%20and%20destroyed.",
     "https://magic.wizards.com/en/news/magic-story/limits-2015-07-15#:~:text=%22A%20great%20host%20of,descends%20on%20Sea%20Gate.%22"
    ]
   },
   {
    "text": "He helped Nissa kill a swarm, told her of Gideon's plan to retake Sea Gate, and joined her in freeing trapped goblins.",
    "cites": [
     "nissas-quest-2015-09-23-e4",
     "nissas-quest-2015-09-23-e5",
     "nissas-quest-2015-09-23-e6"
