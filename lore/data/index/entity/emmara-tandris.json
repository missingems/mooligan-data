  "bio": [
   {
    "text": "She is named as Jace's friend, who no longer remembers him.",
    "cites": [
     "project-lightning-bug-2015-05-27-r6"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/project-lightning-bug-2015-05-27#:~:text=%22She%20doesn%27t%20remember%3F%22"
    ]
   },
   {
    "text": "In the War of the Spark she was the acting guildmaster of Selesnya.",
    "cites": [
     "war-spark-ravnica-desperate-operatives-2019-05-29-r4"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-desperate-operatives-2019-05-29#:~:text=elven%20champion%20and%20acting%20guildmaster%20of%20Selesnya"
    ]
   },
   {
    "text": "She met Kaya beside the dormant dryad Trostani and refused to commit Selesnya because Ral's plans had been disasters.",
    "cites": [
     "war-spark-ravnica-desperate-operatives-2019-05-29-e7"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-desperate-operatives-2019-05-29#:~:text=So%20far%2C%20every%20one,and%20especially%20for%20Selesnya."
    ]
   },
   {
    "text": "Kaya told her the plan was called Operation Desperation and argued that Bolas must be defeated.",
    "cites": [
     "war-spark-ravnica-desperate-operatives-2019-05-29-e8"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/war-spark-ravnica-desperate-operatives-2019-05-29#:~:text=Operation%20Desperation."
    ]
   },
   {
    "text": "Years later, Cim says Emmara Tandris will speak for the Conclave while Trostani goes into communion with Mat'Selesnya.",
    "cites": [
     "episode-10-roots-of-decay-e18"
    ],
    "links": [
     "https://magic.wizards.com/en/news/magic-story/episode-10-roots-of-decay#:~:text=Emmara%20Tandris%20will%20speak,we%20are%20in%20communion"
    ]
   }
  ],
  "status": {
