en"],"date":"2019-01-23","url":"https://magic.wizards.com/en/news/magic-story/illusions-childs-play-2019-01-23","link":"https://magic.wizards.com/en/news/magic-story/illusions-childs-play-2019-01-23#:~:text=He%20grabs%20his%20head,top%20of%20his%20lungs.","archived":null,"license":null,"text":"\"The Illusions of Child's Play\" by Nicky Drayden. Magic Story, Wizards of the Coast, 23 Jan 2019."}},{"id":"illusions-childs-play-2019-01-23-e3","summary":"Kodolaag persuades Olrich to host Zita's effigy sales at the Mockturne by promising him an audience at Rix Maadi.","participants":["kodolaag","olrich","zita"],"location":"the-mockturne","importance":"minor","page":"stories/illusions-childs-play-2019-01-23","order":214,"story_date":"2019-01-23","storyline":"","source":"wizards","paragraph":47,"quote":"I'll call in a favor. I'll get you an audience at Rix Maadi!","link":"https://magic.wizards.com/en/news/magic-story/illusions-childs-play-2019-01-23#:~:text=I%27ll%20call%20in%20a,audience%20at%20Rix%20Maadi%21","citation":{"source":"wizards","official":true,"publisher":"Wizards of the Coast","work":"The Illusions of Child's Play","series":"Magic Story","authors":["Nicky Drayden"],"date":"2019-01-23","url":"https://magic.wizards.com/en/news/magic-story/illusions-childs-play-2019-01-23","link":"https://magic.wizards.com/en/news/magic-story/illusions-childs-play-2019-01-23#:~:text=I%27ll%20call%20in%20a,audience%20at%20Rix%20Maadi%21","archived":null,"license":null,"text":"\"The Illusions of Child's Play\" by Nicky Drayden. Magic Story, Wizards of the Coast, 23 Jan 2019."}},{"id":"illusions-childs-play-2019-01-23-e5","summary":"On the way home Zita fixes graffiti insulting Dovin Baan, and an Azorius arrester arrests her for defacing a building and slandering a Grand Arbiter, with Kodolaag's statement logged against her.","participants":["zita","kodolaag","dovin-baan","azorius-senate"],"location":"ravnica","importance":"major","page":"stories/illusions-childs-play-2019-01-23","o