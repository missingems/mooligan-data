  "bio": [
   {
    "text": "It is described as a paradise no living mortal has entered, where heroes of every clan feast and drink for all time.",
    "cites": [
     "p:stories/know-which-way-wind-blowing-2021-01-08",
     "p:stories/brokenbrow-2021-01-22"
    ],
    "links": [
