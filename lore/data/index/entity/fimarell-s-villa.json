 manuscript.","participants":["daretti","zadrous-fimarell"],"location":"fimarell-s-villa","importance":"minor","page":"stories/bloody-instructions","order":131,"story_date":"2016-08-17","storyline":"","source":"wizards","paragraph":53,"quote":"He balled up the top page of the manuscript and shoved it into Fimarell's mouth.","link":"https://magic.wizards.com/en/news/magic-story/bloody-instructions#:~:text=He%20balled%20up%20the,it%20into%20Fimarell%27s%20mouth.","citation":{"source":"wizards","official":true,"publisher":"Wizards of the Coast","work":"Bloody Instructions","series":"Magic Story","authors":["Shawn Main and Mel Li"],"date":"2016-08-17","url":"https://magic.wizards.com/en/news/magic-story/bloody-instructions","link":"https://magic.wizards.com/en/news/magic-story/bloody-instructions#:~:text=He%20balled%20up%20the,it%20into%20Fimarell%27s%20mouth.","archived":null,"license":null,"text":"\"Bloody Instructions\" by Shawn Main and Mel Li. Magic Story, Wizards of the Coast, 17 Aug 2016."}},{"id":"bloody-instructions-e17","summary":"Daretti heaves Fimarell through the window; he falls two stories to the street.","participants":["daretti","zadrous-fimarell"],"location":"fimarell-s-villa","importance":"major","page":"stories/bloody-instructions","order":131,"story_date":"2016-08-17","storyline":"","source":"wizards","paragraph":59,"quote":"Daretti reached under Fimarell's legs and heaved him up and through the window.","link":"https://magic.wizards.com/en/news/magic-story/bloody-instructions#:~:text=Daretti%20reached%20under%20Fimarell%27s,and%20through%20the%20window.","citation":{"source":"wizards","official":true,"publisher":"Wizards of the Coast","work":"Bloody Instructions","series":"Magic Story","authors":["Shawn Main and Mel Li"],"date":"2016-08-17","url":"https://magic.wizards.com/en/news/magic-story/bloody-instructions","link":"https://magic.wizards.com/en/news/magic-story/bloody-instructions#:~:text=Daretti%20reached%20under%20Fimarell%27s,and%20through%