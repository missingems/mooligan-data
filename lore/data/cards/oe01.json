 "story_date": "2017-06-16",
 "authors": [],
 "storyline_nav": null,
 "paragraphs": [
  {
   "text": "\"Pain is a delusion of the weak. I'll demonstrate.\"",
   "scene": 0,
   "card": "Delight in the Hunt",
   "url": "https://scryfall.com/card/oe01/5%E2%98%85/delight-in-the-hunt"
  },
  {
   "text": "\"Let me unburden you of these fatuous hopes.\"",
   "scene": 0,
   "card": "Every Dream a Nightmare",
   "url": "https://scryfall.com/card/oe01/6%E2%98%85/every-dream-a-nightmare"
  },
  {
   "text": "\"My generosity blesses you all, even the undeserving.\"",
   "scene": 0,
   "card": "For Each of You, a Gift",
   "url": "https://scryfall.com/card/oe01/7%E2%98%85/for-each-of-you-a-gift"
  },
  {
   "text": "\"To think you've spent years honing your body only to die like this.\"",
   "scene": 0,
   "card": "Make Yourself Useful",
   "url": "https://scryfall.com/card/oe01/9%E2%98%85/make-yourself-useful"
  },
  {
   "text": "\"Cry out for your comrades so that they may join you in misery.\"",
   "scene": 0,
   "card": "The Mighty Will Fall",
   "url": "https://scryfall.com/card/oe01/10%E2%98%85/the-mighty-will-fall"
  },
  {
   "text": "\"Groveling already? I'm just starting to enjoy myself.\"",
   "scene": 0,
   "card": "My Laughter Echoes",
   "url": "https://scryfall.com/card/oe01/12%E2%98%85/my-laughter-echoes"
  },
  {
   "text": "\"Your companions were lucky to have died first.\"",
   "scene": 0,
   "card": "No One Will Hear Your Cries",
   "url": "https://scryfall.com/card/oe01/13%E2%98%85/no-one-will-hear-your-cries"
  },
  {
   "text": "\"The gates open to my new era.\"",
   "scene": 0,
   "card": "A Reckoning Approaches",
   "url": "https://scryfall.com/card/oe01/16%E2%98%85/a-reckoning-approaches"
  },
  {
   "text": "\"The dunes smell spilled blood.\"",
   "scene": 0,
   "card": "There Is No Refuge",
   "url": "https://scryfall.com/card/oe01/17%E2%98%85/there-is-no-refuge"
  },
  {
   "text": "\"Little insects, I have created entire worlds and extinguished twice as many.\"",
   "scene": 0,
   "card": "This World Belongs to Me",
   "url": "https://scryfall.com/card/oe01/18%E2%98%85/this-world-belongs-to-me"
  },
  {
   "text": "\"Vow your allegiance to true power.\"",
   "scene": 0,
   "card": "What's Yours Is Now Mine",
   "url": "https://scryfall.com/card/oe01/19%E2%98%85/whats-yours-is-now-mine"
  },
  {
   "text": "\"Don't fret, infants. It wouldn't have worked anyway.\"",
   "scene": 0,
   "card": "When Will You Learn?",
   "url": "https://scryfall.com/card/oe01/20%E2%98%85/when-will-you-learn%3F"
  }
 ]
}
