   "scene": 0,
   "card": "Seafloor Oracle",
   "url": "https://scryfall.com/card/prix/51p/seafloor-oracle"
  },
  {
   "text": "\"Drench these golden streets in the blood of our enemies.\"",
   "scene": 0,
   "card": "Champion of Dusk",
   "url": "https://scryfall.com/card/prix/64s/champion-of-dusk"
  },
  {
