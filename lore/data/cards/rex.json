 "paragraphs": [
  {
   "text": "\"Keep absolutely still. Its vision is based on movement.\" —Alan Grant",
   "scene": 0,
   "card": "Don't Move",
   "url": "https://scryfall.com/card/rex/1/dont-move"
  },
  {
   "text": "\"There's no reason for it to fear man.\" —Robert Burke",
   "scene": 0,
   "card": "Compy Swarm",
   "url": "https://scryfall.com/card/rex/9/compy-swarm"
  },
  {
   "text": "\"I don't control the raptors. It's a relationship. It's based on mutual respect.\"",
   "scene": 0,
   "card": "Owen Grady, Raptor Trainer",
   "url": "https://scryfall.com/card/rex/16/owen-grady-raptor-trainer"
  },
  {
   "text": "\"Dinosaurs left their blueprints behind for us.\" —Mr. DNA",
   "scene": 0,
   "card": "Dino DNA",
   "url": "https://scryfall.com/card/rex/20/dino-dna"
  },
  {
   "text": "\"Corporate felt genetic modification would up the 'wow' factor.\" —Claire Dearing",
   "scene": 0,
   "card": "Command Tower",
   "url": "https://scryfall.com/card/rex/26/command-tower-command-tower"
  },
  {
   "text": "\"They're dinosaurs. 'Wow' enough.\" —Owen Grady",
   "scene": 0,
   "card": "Command Tower",
   "url": "https://scryfall.com/card/rex/26/command-tower-command-tower"
  },
  {
   "text": "It preyed on anything it could sink its teeth into.",
   "scene": 0,
   "card": "Cresting Mosasaurus",
   "url": "https://scryfall.com/card/rex/28/cresting-mosasaurus"
  },
  {
   "text": "\"Nice boy . . . nice boy. Nice dinosaur!\"",
   "scene": 0,
   "card": "Spitting Dilophosaurus",
   "url": "https://scryfall.com/card/rex/29/spitting-dilophosaurus"
  },
  {
   "text": "\"Clever girl.\" —Robert Muldoon",
   "scene": 0,
   "card": "Hunting Velociraptor",
   "url": "https://scryfall.com/card/rex/30/hunting-velociraptor"
  },
  {
   "text": "\"Life breaks free. It expands to new territories and crashes through barriers. Painfully, maybe even dangerously. But, uh, well there it is.\" —Ian Malcolm",
   "scene": 0,
   "card": "Life Finds a Way",
   "url": "https://scryfall.com/card/rex/31/life-finds-a-way"
  },
  {
   "text": "\"Well... it's a superpredator.\" —Billy Brennan",
   "scene": 0,
   "card": "Savage Order",
   "url": "https://scryfall.com/card/rex/32/savage-order"
  },
  {
   "text": "\"You've heard of chaos theory?\"",
   "scene": 0,
   "card": "Ian Malcolm, Chaotician",
   "url": "https://scryfall.com/card/rex/38/ian-malcolm-chaotician"
  },
  {
   "text": "\"Ah, ah, ah! You didn't say the magic word.\"",
   "scene": 0,
   "card": "Permission Denied",
   "url": "https://scryfall.com/card/rex/42/permission-denied"
  }
 ]
}
